{
  "name": "company-files",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared file storage: department folders, group access, restricted subfolders, trash, versions, expiring links.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.mjs",
    "admin": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/admin.mjs",
    "backup": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/backup.mjs",
    "check": "node --disable-warning=ExperimentalWarning test/check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  }
}
