# Copy to .env and adjust. Every value has a default; an empty .env is fine for a local test.

# Where the server listens. Keep 127.0.0.1 when a reverse proxy (nginx, Caddy, IIS) terminates HTTPS in front.
HOST=127.0.0.1
PORT=8800

# The address people type in the browser. Starting with https:// turns on Secure cookies and HSTS.
PUBLIC_URL=http://localhost:8800

# Database and files. Production: a local disk that is NOT synced by OneDrive/Dropbox.
DATA_DIR=data

APP_NAME=Company Files
MAX_FILE_GB=10
PERSONAL_QUOTA_GB=20

# HTTPS directly in Node (PEM files). Leave empty when a reverse proxy handles HTTPS.
TLS_CERT=
TLS_KEY=
# Set to 1 only behind a reverse proxy, so the real client IP is taken from X-Forwarded-For.
TRUST_PROXY=0

# Nightly backup target: another disk or a share on another server (spec 8.1).
BACKUP_DIR=
BACKUP_KEEP_DAYS=120

# Outgoing mail for sign-up codes (invite links on the People page). Port 465 = TLS, 587 = STARTTLS.
# Without SMTP_HOST, sign-up is off. Use a separate mailbox such as noreply@your-domain.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Company Files <noreply@example.kz>
